NEXT_PUBLIC_MEGAPOT_REWARD_VAULT_ADDRESS=0x7Ec9088C4A9Bf88dC38FEdb649FD7303E5391ea9

# Public project links (docs / jam submission — also in src/lib/projectLinks.js)
