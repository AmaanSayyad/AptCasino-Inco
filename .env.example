NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Get a free project ID at https://cloud.walletconnect.com — required for ConnectKit's
# WalletConnect/mobile-wallet option (injected browser wallets still work without it).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APTCASINO_ADDRESS=0x9A9974B0C0A2A3855528e9b0eE68931c705A0E0F
NEXT_PUBLIC_MEGAPOT_REWARD_VAULT_ADDRESS=0x9BCf1914F96f4b438Fb22aAE7ba46343FBC8ADB8

# Supabase project backing profile/referral/leaderboard/kol/live/competition/dashboard/history.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-side-only

# Wallet that receives Volume Cup USDC entry fees. Leave unset to disable paid registration.
NEXT_PUBLIC_TOURNAMENT_TREASURY_ADDRESS=

# Bearer token required to use /dashboard and the admin APIs it calls.
DASHBOARD_ADMIN_TOKEN=
