NEXT_PUBLIC_SITE_URL=https://aptcasino-inco-gamma.vercel.app
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Get a free project ID at https://cloud.walletconnect.com — required for ConnectKit's
# WalletConnect/mobile-wallet option (injected browser wallets still work without it).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APTCASINO_ADDRESS=0xe2c0864966d8bB7B2c334A7bd27945970Dc68792
NEXT_PUBLIC_MEGAPOT_REWARD_VAULT_ADDRESS=0xC4be5B0c5C3d9F163B138e187BfCa82cA2aEAC80
# Wallet that receives Megapot referral fees (ticket fee + win-share) on every claim buy.
NEXT_PUBLIC_PLATFORM_REFERRER=0x0F455b5a385c508142a2861e0f541550119afA28
# Optional Megapot Data API (testnet anonymous works without a key).
MEGAPOT_DATA_API_URL=https://api-testnet.megapot.io/v1
MEGAPOT_DATA_API_KEY=

# Public project links (docs / jam submission — also in src/lib/projectLinks.js)
# Live: https://aptcasino-inco-gamma.vercel.app/
# GitHub: https://github.com/AmaanSayyad/AptCasino-Inco
# Deck: https://www.figma.com/deck/vcXvmRFqhTN5Sj85ZrYf1i/AptCasino-Inco-x-Megapot
# Contact: amaansayyad2001@gmail.com

# Supabase project backing profile/referral/leaderboard/kol/live/competition/dashboard/history.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-side-only

# Wallet that receives Volume Cup USDC entry fees. Leave unset to disable paid registration.
NEXT_PUBLIC_TOURNAMENT_TREASURY_ADDRESS=

# Bearer token required to use /dashboard and the admin APIs it calls.
DASHBOARD_ADMIN_TOKEN=

# Custodial treasury: users deposit USDC here, the server signs plays on their behalf
# (0 wallet signatures per round after deposit). TREASURY_PRIVATE_KEY is server-only,
# never exposed to the client — needs Base Sepolia ETH (gas+Inco fees) funded manually.
NEXT_PUBLIC_TREASURY_ADDRESS=
TREASURY_PRIVATE_KEY=
